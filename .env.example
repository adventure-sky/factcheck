# 假訊息情報中心 環境變數設定範例
# 本地開發：複製此檔為 backend/.env 並填入實際 key
# Railway 部署：在 service 的 Variables 頁面逐項設定（不要 commit .env）

# ── 必要 ────────────────────────────────────────────────────────────────
# Groq API：主要 AI 模型（llama-3.3-70b-versatile），文字分析與報告生成
GROQ_API_KEY=your-groq-api-key-here

# Google Fact Check Tools API：查詢國際事實查核機構資料
GOOGLE_FACT_CHECK_API_KEY=your-google-api-key-here

# AI or Not API：AI 生成圖片偵測（Bearer JWT token）
AIORNOT_API_KEY=your-aiornot-jwt-here

# ── 選配（未設定時自動靜默降級，不影響其他功能）──────────────────────────
# Google Custom Search：網路搜尋佐證
# 注意：Google Cloud 專案需綁定付款方式，否則回 403
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Hive AI：備用圖片偵測（AI or Not 失敗時使用）
HIVE_API_KEY=

# ── 本地開發專用 ────────────────────────────────────────────────────────
# ChromaDB 路徑。Railway 免費版未安裝 chromadb/sentence-transformers，
# RAG 會經 ImportError 守衛降級為空結果，此變數在生產環境無需設定。
CHROMA_DB_PATH=./chroma_db
